# Copy thành deploy/.env rồi điền. File .env đã nằm trong .gitignore, KHÔNG commit.

# Mật khẩu Postgres. Dùng chuỗi hex để không có ký tự đặc biệt làm hỏng địa chỉ kết nối:
#   openssl rand -hex 24
DB_PASSWORD=

# Địa chỉ trang quản trị, đúng như gõ trên trình duyệt (có https, không có dấu / cuối)
FRONTEND_URL=https://chatadmin.benthanhtourist.com
# Frontend và backend cùng tên miền nên để trống
COOKIE_DOMAIN=

# Chuỗi ngẫu nhiên từ 32 ký tự:   openssl rand -hex 48
JWT_SECRET=
# Khoá chatbot bttAI đẩy tin vào, đặt giống bên chatbot:   openssl rand -hex 32
INGEST_API_KEY=

# Khoá mã hoá thông tin kết nối Zalo/Facebook lưu trong database (đổi khoá thì phải nhập lại thông tin):   openssl rand -hex 32
ENCRYPTION_KEY=

# Phiên đăng nhập trượt (để trống = 7 ngày không dùng thì hết, tối đa 30 ngày)
SESSION_DAYS=
SESSION_MAX_DAYS=

CONTACT_ACCEPT_MINUTES=3
COLLISION_WARN_SECONDS=60
WORK_HOUR_START=8
WORK_HOUR_END=17.5
GEMINI_PRICE_INPUT_PER_M=0.25
GEMINI_PRICE_OUTPUT_PER_M=1.5
USD_VND_RATE=26000
TOUR_API_URL=

# Ảnh/PDF lưu trên ổ đĩa server (compose đã đặt STORAGE_DIR=/data/files), không cần khai Supabase.
