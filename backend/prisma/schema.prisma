// Trang quản trị hội thoại chatbot. Xem docs/data-model.md.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

// Prisma 7: địa chỉ database không nằm ở đây nữa.
// Địa chỉ database là DATABASE_URL: migrate đọc ở prisma.config.ts, ứng dụng đọc ở src/prisma/prisma.service.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN // Toàn quyền: tạo mọi tài khoản, xem mọi phòng
  SALE // Nhắn tin với khách
  DEPT_ADMIN // Admin phòng ban: thống kê, hội thoại và tài khoản sale của phòng mình
  DIGITAL // Admin Digital: chỉ xem nhu cầu tour trong các phòng được cấp quyền
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users User[]

  @@map("departments")
}

// ZALO và FACEBOOK để sẵn cho tích hợp sau, hiện chưa có dữ liệu đổ vào.
enum Channel {
  WEB
  APP
  ZALO
  FACEBOOK
}

enum ConversationStatus {
  CONTACT // Liên hệ: khách đòi gặp nhân viên, luôn ghim đầu
  UNREAD // Chưa xem
  READ // Đã xem
  PENDING // Chờ xử lý
  CLOSED // Đã chốt
}

enum ConversationMode {
  BOT
  STAFF
}

enum SenderType {
  CUSTOMER
  BOT
  AUTO // Trả lời tự động theo quy tắc
  STAFF
  SYSTEM
}

// Đơn khách tự đặt qua chatbot là PENDING cho tới khi sale gọi xác nhận hoặc hệ thống đặt tour báo đã thanh toán.
enum DealStatus {
  PENDING // Chờ xác nhận
  CONFIRMED // Đã chốt, tính doanh thu
  CANCELLED // Khách huỷ, hoặc booking bị huỷ / hoàn tiền
}

enum DealSource {
  CHATBOT // Khách tự đặt trong khung chat
  STAFF // Sale nhập khi chốt
  APP // Khách tự đặt trong app Mobile
}

// Voucher giảm theo số tiền, hoặc theo phần trăm có mức trần (chủ dự án chốt 11/11/2026).
enum VoucherType {
  AMOUNT
  PERCENT
}

// Phạm vi voucher: một tour, một địa điểm (thể loại tour của website), hoặc mọi tour.
enum VoucherScope {
  TOUR
  CATEGORY
  ALL
}

enum AutoReplyType {
  FIRST_MESSAGE
  KEYWORD
  OFF_HOURS
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  employeeCode   String?   @unique
  position       String?
  avatarPath     String? // Ảnh đại diện nhân viên tự tải lên ở trang cá nhân (đường dẫn trong nơi lưu file)
  role           Role      @default(SALE)
  departmentId   String? // Phòng ban của sale / admin phòng; ADMIN và DIGITAL để trống
  scopeIds       String[]  @default([]) // DIGITAL: các phòng được phép xem
  onDuty         Boolean   @default(true)
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assigned  Conversation[]    @relation("Assignee")
  helping   Conversation[]    @relation("Helper")
  followUps Conversation[]    @relation("FollowUpBy")
  responses ContactResponse[]
  messages  Message[]
  deals     Deal[]
  templates QuickTemplate[]
  tourTags  TourInterestTag[]
  vouchers  Voucher[]
  appAccountsCreated AppAccount[]

  @@index([departmentId])
  @@map("users")
}

model Customer {
  id            String   @id @default(uuid())
  name          String
  aliases       String[] @default([]) // Các cách viết tên khác khách từng nhập
  phone         String?  @unique // Dạng số 0xxxxxxxxx
  phoneVerified Boolean  @default(false) // App đã đăng nhập = true, web chưa có OTP = false
  avatarUrl     String? // Ảnh đại diện (Zalo trả link), kênh khác để trống
  // Tên, các tên khác và SĐT viết thường, bỏ dấu. Trigger customers_search_text trong database tự điền, không ghi tay.
  searchText    String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  identities    CustomerIdentity[]
  conversations Conversation[]
  deals         Deal[]
  appAccount    AppAccount?

  // Tìm "chứa chuỗi" (LIKE '%...%') cần chỉ mục trigram, chỉ mục thường không dùng được.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("customers")
}

// Một khách có thể có nhiều mã theo kênh: id tài khoản app, mã thiết bị web, sau này là Zalo user id, Facebook PSID.
model CustomerIdentity {
  id         String   @id @default(uuid())
  channel    Channel
  externalId String
  customerId String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([channel, externalId])
  @@index([customerId])
  @@map("customer_identities")
}

// Mỗi khách có đúng 1 hội thoại liên tục trên mỗi kênh, kể cả khi đổi máy hoặc xoá chat phía khách.
model Conversation {
  id                    String             @id @default(uuid())
  customerId            String
  channel               Channel
  status                ConversationStatus @default(UNREAD)
  mode                  ConversationMode   @default(BOT)
  assigneeId            String?
  helperId              String? // Không dùng nữa từ khi bỏ "Xử lý hộ" (2026-11-06), giữ cột để không mất dữ liệu cũ
  lastHandlerId         String? // Người phụ trách gần nhất, dùng để chia khách cũ về người cũ
  autoReplyOn           Boolean            @default(true)
  interest              String?
  tags                  String[]           @default([])
  note                  String?
  lastMessageAt         DateTime           @default(now())
  lastMessagePreview    String?
  // Tin gần nhất của khách. Trigger messages_last_customer tự điền, để thống kê không phải quét bảng tin nhắn.
  lastCustomerMessageAt DateTime?
  contactRequestedAt    DateTime?
  contactAssignedAt     DateTime?
  lastStaffActivityAt   DateTime? // Lần cuối người xử lý gõ hoặc gửi tin, quyết định khoá khung nhắn
  lastStaffActivityBy   String?
  followUpAt            DateTime? // Hẹn gọi lại / nhắn lại khách
  followUpNote          String?
  followUpById          String?
  followUpNotifiedAt    DateTime? // Đã nhắc người hẹn, để không nhắc lặp
  customerSeenAt        DateTime? // Lần cuối khung chat phía khách mở và lấy tin nhân viên
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  customer   Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee   User?             @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  helper     User?             @relation("Helper", fields: [helperId], references: [id], onDelete: SetNull)
  followUpBy User?             @relation("FollowUpBy", fields: [followUpById], references: [id], onDelete: SetNull)
  responses  ContactResponse[]
  messages   Message[]
  deals      Deal[]
  tourTags   TourInterestTag[]
  placeInterests PlaceInterest[]

  @@unique([customerId, channel])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt]) // Hộp thư: hội thoại mới nhất, trừ Liên hệ
  @@index([lastCustomerMessageAt]) // Thống kê khách nhắn tin trong kỳ
  @@index([assigneeId, status])
  @@index([followUpAt])
  @@index([tags], type: Gin) // Lọc theo nhãn
  @@map("conversations")
}

model Message {
  id                String     @id @default(uuid())
  conversationId    String
  senderType        SenderType
  staffId           String?
  staffLabel        String? // Ví dụ "Minh, xử lý hộ Thảo"
  ruleName          String?
  text              String
  internal          Boolean    @default(false) // Log chỉ admin thấy, không bao giờ gửi cho khách
  isTrigger         Boolean    @default(false) // Câu khách đòi gặp nhân viên
  tours             Json? // Thẻ tour bot gửi kèm
  externalMessageId String?    @unique // Chống ghi trùng khi chatbot gửi lại
  replyToId         String? // Nhân viên trả lời trích một tin
  attachmentPath    String? // Đường dẫn file trong Supabase Storage (bucket riêng tư), không phải link
  attachmentType    String? // image/jpeg, image/png, image/webp, application/pdf
  attachmentName    String?
  attachmentSize    Int? // byte, sau khi đã thu nhỏ
  createdAt         DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        User?        @relation(fields: [staffId], references: [id], onDelete: SetNull)
  replyTo      Message?     @relation("ReplyTo", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("ReplyTo")
  tourTags     TourInterestTag[]
  placeInterests PlaceInterest[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model QuickTemplate {
  id          String   @id @default(uuid())
  title       String
  body        String
  shortcut    String?  @unique
  category    String?
  useCount    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("quick_templates")
}

model AutoReplyRule {
  id        String        @id @default(uuid())
  name      String
  type      AutoReplyType
  keywords  String[]      @default([])
  body      String
  channels  Channel[]     @default([WEB, APP, ZALO, FACEBOOK])
  enabled   Boolean       @default(true)
  sentCount Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("auto_reply_rules")
}

// Đơn chốt qua chatbot, nguồn của số doanh thu.
model Deal {
  id               String     @id @default(uuid())
  conversationId   String
  customerId       String
  channel          Channel
  closedById       String? // Sale chốt hoặc xác nhận đơn. null = chưa ai xác nhận, hoặc tự xác nhận khi booking đã thanh toán
  status           DealStatus @default(PENDING) // Chatbot ghi thẳng database không đặt cột này, nên mặc định là đơn chờ xác nhận
  source           DealSource @default(CHATBOT)
  orderCode        String?    @unique // Mã booking bên hệ thống đặt tour
  tourCode         String? // Mã đợt khởi hành trên benthanhtourist.com, ví dụ A06.FIT.TW.070227.A
  tourName         String
  guests           Int
  amount           BigInt // VND
  tourKey          String? // id tour trên benthanhtourist.com (chung mọi ngày khởi hành)
  departureDate    DateTime? @db.Date
  unitPrice        BigInt? // Giá/người của ngày khởi hành, lấy từ API tour, sale không sửa
  subtotal         BigInt? // unitPrice × guests, trước voucher
  voucherId        String?
  voucherCode      String?
  discount         BigInt? // Số tiền voucher giảm; amount = subtotal - discount
  bookingStatus    String? // Trạng thái booking BE Mobile báo về: PENDING, CONFIRMED, PAID, ONGOING, COMPLETED, CANCELLED, REFUNDED
  bookingUpdatedAt DateTime?
  createdAt        DateTime   @default(now()) // Lúc khách đặt hoặc sale nhập
  closedAt         DateTime   @default(now()) // Lúc chốt; đơn chờ xác nhận thì cập nhật khi xác nhận
  voidedAt         DateTime? // Mở lại hội thoại thì đơn không còn tính doanh thu
  // Đơn khách đặt trong app (nguồn APP), xem common/app-booking.ts. Đơn khác để trống.
  adults           Int?
  children         Int? // 2–15 tuổi, 80% giá
  infants          Int? // dưới 2 tuổi, 40% giá
  notice           String? // Ghi chú của khách
  departureKey     String? // id đợt khởi hành trên benthanhtourist.com (tour_days[].id)
  returnDate       DateTime? @db.Date // Ngày về, để tự chuyển Hoàn thành
  tourImage        String?
  pointsAwarded    Int? // Điểm đã cộng khi Hoàn thành; có giá trị thì không cộng lần nữa

  guestList DealGuest[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  closedBy     User?        @relation(fields: [closedById], references: [id], onDelete: SetNull)
  voucher      Voucher?     @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([closedAt])
  @@index([voucherId])
  @@index([conversationId])
  @@index([customerId])
  @@map("deals")
}

// Mỗi lần khách đòi gặp nhân viên và được trả lời: nguồn số "thời gian phản hồi".
model ContactResponse {
  id             String   @id @default(uuid())
  conversationId String
  staffId        String?
  requestedAt    DateTime
  respondedAt    DateTime @default(now())
  seconds        Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  staff        User?        @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([respondedAt])
  @@index([conversationId])
  @@map("contact_responses")
}

// Mỗi lần gọi Gemini ghi 1 dòng: Google không có API trả số tiền theo key.
model AiUsage {
  id             String   @id @default(uuid())
  conversationId String?
  model          String
  inputTokens    Int
  outputTokens   Int
  createdAt      DateTime @default(now())

  // Bảng chỉ ghi nối đuôi theo thời gian: BRIN nhỏ hơn B-tree hàng trăm lần mà vẫn lọc được theo kỳ.
  @@index([createdAt], type: Brin)
  @@map("ai_usage")
}

// Sale gắn "tour quan tâm" cho hội thoại, mỗi nhãn ghim đúng một tin làm bằng chứng. Cùng tour gắn lại sau là dòng mới (lần 2, lần 3).
model TourInterestTag {
  id             String   @id @default(uuid())
  conversationId String
  messageId      String
  tourKey        String // id tour trên benthanhtourist.com
  tourName       String
  categoryId     Int? // Địa điểm (thể loại cụ thể nhất của tour)
  categoryName   String?
  createdById    String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([tourKey, createdAt])
  @@index([createdAt])
  @@map("tour_interest_tags")
}

// Thông tin kết nối kênh (Zalo OA, Facebook) do admin nhập ở trang Kênh kết nối. Giá trị luôn mã hoá AES-256-GCM bằng ENCRYPTION_KEY trong .env.
model ChannelSecret {
  channel     Channel
  name        String // Tên trường, ví dụ appSecret, accessToken
  valueEnc    String // Đã mã hoá, không bao giờ trả về trình duyệt
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@id([channel, name])
  @@map("channel_secrets")
}

// Voucher do admin phòng ban (admin chi nhánh) hoặc admin toàn quyền tạo. Số lần đã dùng đếm từ đơn đã chốt, không lưu bộ đếm.
model Voucher {
  id           String       @id @default(uuid())
  code         String       @unique // Viết hoa, không dấu
  type         VoucherType
  value        Int // AMOUNT: số đồng; PERCENT: 1-100
  maxDiscount  BigInt? // PERCENT: giảm tối đa
  scope        VoucherScope
  tourKey      String?
  tourName     String?
  categoryId   Int?
  categoryName String?
  startsAt     DateTime
  endsAt       DateTime
  maxUses      Int? // null = không giới hạn
  /// Chỉ khách đúng bậc thành viên này dùng được (DONG, BAC, VANG, BACH_KIM, KIM_CUONG, RUBY). null = mọi khách. Chốt 2026-11-16.
  tier         String?
  /// Mỗi khách dùng tối đa bấy nhiêu lần trong một tháng (giờ Việt Nam). null = không giới hạn.
  maxUsesPerCustomerMonth Int?
  note         String?
  isActive     Boolean      @default(true) // false = tạm khoá
  departmentId String? // Phòng tạo voucher; admin toàn quyền tạo thì để trống
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  deals     Deal[]

  @@index([departmentId])
  @@map("vouchers")
}

/// Địa điểm khách tự hỏi, máy nhận ra từ tin của khách ("tour TQ" -> Trung Quốc), chốt 2026-11-13.
/// Mỗi khách mỗi địa điểm chỉ một dòng trong một ngày (giờ Việt Nam), giữ tin đầu tiên của ngày làm bằng chứng.
model PlaceInterest {
  id             String   @id @default(uuid())
  conversationId String
  customerId     String
  messageId      String
  place          String // Tên chuẩn, vd "Trung Quốc"
  day            String // YYYY-MM-DD giờ Việt Nam
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([customerId, place, day])
  @@index([createdAt])
  @@index([conversationId])
  @@map("place_interests")
}

/// Tài khoản đăng nhập app Mobile của khách (chủ dự án chốt 2026-11-16). Chỉ sale tạo, khi khách đã có SĐT và đã chốt tour.
/// Tên đăng nhập là SĐT; mật khẩu ngẫu nhiên 6 ký tự, chỉ hiện cho sale một lần. Tên, SĐT nằm ở bảng customers.
model AppAccount {
  id               String    @id @default(uuid())
  customerId       String    @unique
  phone            String    @unique // SĐT đăng nhập, dạng 0xxxxxxxxx
  passwordHash     String
  refreshTokenHash String? // Băm của refresh token đang dùng; đăng xuất thì xoá
  pinHash          String? // Mã PIN 6 số (băm)
  fcmToken         String? // Token thông báo đẩy Firebase của máy đang đăng nhập
  email            String?
  dateOfBirth      DateTime? @db.Date
  gender           String?
  nationalId       String?
  passportNumber   String?
  passportExpiry   DateTime? @db.Date
  isActive         Boolean   @default(true)
  earnedPoints     Int       @default(0) // Điểm tích luỹ xét bậc thành viên, 1.000 đ = 1 điểm, cộng khi đơn Hoàn thành
  avatarPath       String? // Ảnh đại diện khách tải lên trong app (đường dẫn trong nơi lưu file, không phải link)
  createdById      String?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy     User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  notifications AppNotification[]
  favorites     AppFavorite[]
  feedbacks     AppFeedback[]

  @@map("app_accounts")
}

/// Thông báo trong app (danh sách chuông). Chưa gửi thông báo đẩy. Tạo khi đơn đổi trạng thái.
model AppNotification {
  id        String   @id @default(uuid())
  accountId String
  title     String
  message   String
  type      String // BOOKING_STATUS, SYSTEM
  refType   String? // BOOKING: refId là id đơn (deals.id)
  refId     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  account AppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("app_notifications")
}

/// Tour yêu thích. Giữ ảnh chụp tên, ảnh, giá lúc thêm để hiện danh sách không cần gọi website.
model AppFavorite {
  id            String    @id @default(uuid())
  accountId     String
  tourKey       String
  tourName      String
  tourImage     String?
  durationText  String?
  unitPrice     BigInt?
  departureDate DateTime? @db.Date
  createdAt     DateTime  @default(now())

  account AppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tourKey])
  @@map("app_favorites")
}

/// Góp ý khách gửi trong app.
model AppFeedback {
  id        String   @id @default(uuid())
  accountId String
  subject   String
  content   String
  createdAt DateTime @default(now())

  account AppAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("app_feedbacks")
}

/// Tệp (bộ) sticker: nhiều sticker chung một tệp, bảng chọn trong chat chia tab theo tệp. Ẩn tệp thì ẩn mọi sticker trong tệp khỏi bảng chọn.
model StickerPack {
  id        String    @id @default(uuid())
  name      String    @unique
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  stickers  Sticker[]

  @@map("sticker_packs")
}

/// Kho sticker dùng chung; giữ bản WebP xem trước và GIF để gửi qua các kênh.
model Sticker {
  id        String       @id @default(uuid())
  name      String
  webpPath  String
  gifPath   String
  gifSize   Int
  width     Int
  height    Int
  animated  Boolean
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  packId    String? // Trống = sticker chưa xếp vào tệp nào (hiện ở tab "Khác")
  zaloStickerId String? // Mã sticker có sẵn của Zalo; có thì gửi sang Zalo bằng sticker Zalo (động) thay cho ảnh GIF tự tải lên
  pack      StickerPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@index([active, createdAt])
  @@index([packId])
  @@map("stickers")
}

/// Hành khách của một đơn đặt từ app (khách 1 = người đặt, position 0). Dùng làm thủ tục vé, visa.
model DealGuest {
  id             String    @id @default(uuid())
  dealId         String
  position       Int
  fullName       String
  dateOfBirth    DateTime? @db.Date
  gender         String?
  nationalId     String?
  passportNumber String?
  phone          String?

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@map("deal_guests")
}
