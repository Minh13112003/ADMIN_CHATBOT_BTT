NODE_ENV=development
PORT=4000
# Không bắt buộc. Có Redis thì nhiều backend chia sẻ socket và trạng thái đang soạn.
REDIS_URL=
# Địa chỉ frontend được phép gọi API, nhiều địa chỉ thì cách nhau bằng dấu phẩy
FRONTEND_URL=http://localhost:3002
# Production chạy trên 2 tên miền con thì đặt .ten-mien-cua-ban.com để cookie dùng chung
COOKIE_DOMAIN=

# Supabase: Project Settings > Database > Connection string
# Dùng Session pooler (cổng 5432): chạy ứng dụng và migrate đều dùng được. Không dùng Transaction pooler (cổng 6543) cho migrate.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Supabase Storage lưu ảnh/PDF trong chat. Bucket phải để RIÊNG TƯ (private).
# SUPABASE_URL chỉ là phần gốc, không có /rest/v1. Khoá SECRET (sb_secret_...) chỉ để ở backend, không đưa ra frontend, app, chatbot.
# Ưu tiên: STORAGE_DIR là thư mục tuyệt đối trên ổ đĩa (dùng khi tự chạy trên VPS). Đặt thì không cần 3 biến Supabase bên dưới.
STORAGE_DIR=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=

# Chuỗi ngẫu nhiên từ 32 ký tự trở lên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Phiên đăng nhập trượt: đang dùng thì tự gia hạn. Không mở trang quá SESSION_DAYS ngày thì đăng nhập lại;
# tối đa SESSION_MAX_DAYS ngày kể từ lần nhập mật khẩu. Để trống = 7 và 30.
SESSION_DAYS=
SESSION_MAX_DAYS=
# Khoá để chatbot bttAI đẩy tin vào, đặt giống bên chatbot
INGEST_API_KEY=

# Khoá mã hoá thông tin kết nối Zalo/Facebook lưu trong database (đổi khoá thì phải nhập lại thông tin):   openssl rand -hex 32
ENCRYPTION_KEY=

# Phân việc: khách đòi gặp nhân viên mà sau số phút này chưa ai trả lời thì chuyển người khác
CONTACT_ACCEPT_MINUTES=3
# Đồng nghiệp vừa gửi tin trong số giây này thì người khác bấm gửi sẽ được hỏi lại (không khoá)
COLLISION_WARN_SECONDS=60
# Giờ làm việc theo giờ Việt Nam, 17.5 = 17:30. Cần công ty xác nhận
WORK_HOUR_START=8
WORK_HOUR_END=17.5

# Chi phí Gemini: USD cho 1 triệu token (gemini-3.1-flash-lite, ngày 2026-11-05) và tỷ giá tự đặt
GEMINI_PRICE_INPUT_PER_M=0.25
GEMINI_PRICE_OUTPUT_PER_M=1.5
USD_VND_RATE=26000

# Danh mục tour (chỉ đọc, không cần khoá). Để trống = https://benthanhtourist.com/api/tour
TOUR_API_URL=
